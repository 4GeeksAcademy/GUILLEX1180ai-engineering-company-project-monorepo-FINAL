# ─── Node.js ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/
.pnpm/

# ─── Build / Output ───────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── Environment ──────────────────────────────────────────────────
# Todos los entornos (raíz, services/api, uis/*)
.env
.env.local
.env.*.local
.env.*.production
.env.development

# Allow .env.example files (templates) — se versionan a propósito
!.env.example
!**/.env.example

# ─── Secretos / credenciales ─────────────────────────────────────
# Nunca subir claves ni credenciales de Firebase/Supabase/etc.
serviceAccountKey*.json
*.pem
*.key
*.p12
*.pfx
firebase-*.json
google-credentials.json

# ─── IDE / Editor ─────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs & Temp ──────────────────────────────────────────────────
*.log
tmp/
temp/

# ─── TypeScript ───────────────────────────────────────────────────
*.tsbuildinfo

# ─── Coverage ─────────────────────────────────────────────────────
coverage/
.nyc_output/
.coverage

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
env/
venv/
.venv/
.pytest_cache/
.mypy_cache/

# ─── Imágenes de referencia (grandes) ─────────────────────────────
# No subir imágenes binarias grandes usadas solo para documentación
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg# ─── Output generado ──────────────────────────────────────────
results.csv
scripts/results.csv
*.db.json
*_db.json
