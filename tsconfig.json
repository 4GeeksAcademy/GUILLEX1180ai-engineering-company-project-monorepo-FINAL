{
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true
  },
  "include": [],
  "exclude": ["**/node_modules", "**/.*"]
}