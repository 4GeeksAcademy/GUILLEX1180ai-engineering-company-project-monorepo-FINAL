# =============================================================================
# TrackFlow — Variables de Entorno (ejemplo raíz)
# =============================================================================
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ⚠️  NUNCA incluyas el archivo .env en el control de versiones (ver .gitignore).
# =============================================================================

# ── Backend ───────────────────────────────────────────────────────
APP_NAME=TrackFlow
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# URL pública del frontend (CORS + enlace de reset de contraseña)
FRONTEND_URL=http://localhost:3001

# Orígenes CORS permitidos (coma-separado (el backend usa parse_cors_origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000,http://frontend:3001

# ── Seguridad JWT (reseteo de contraseña) ────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
PASSWORD_RESET_WINDOW_SECONDS=3600

# ── Email transaccional ──────────────────────────────────────────
# Proveedor: log (dev) | resend | sendgrid
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=TrackFlow <no-reply@trackflow.local>
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@trackflow.local

# ── Frontend (Next.js) ───────────────────────────────────────────
# URL base de la API para el fetch (ya incluye /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
# Host del backend para el proxy inverso (Docker: "backend"; local: "localhost")
BACKEND_HOST=localhost
