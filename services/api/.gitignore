# =============================================================================
# .gitignore del backend — Evitar fugas de secretos y contaminación del repo
# =============================================================================

# Entorno y secretos (NUNCA versionar)
.env
.env.*
!.env.example

# Python / venv / caché
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Dependencias y artefactos
*.egg-info/
dist/
build/

# Tests (no necesarios en producción pero sí en el repo)
# tests/  # Comentado: los tests se versionan para CI/CD

# VSCode / IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/

# BD local (nunca versionar las bases de datos JSON de TinyDB)
*_db.json
!auth_db.json.example

# Logs
*.log
tmp/