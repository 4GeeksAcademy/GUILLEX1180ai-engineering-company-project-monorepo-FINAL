# ─── TrackFlow — Variables de Entorno ──────────────────────
# Copia este archivo a .env y completa los valores

# Backend (FastAPI — services/api/)
# ── Seguridad JWT ─────────────────────────────────────────────
# Clave secreta para firmar/verificar tokens de restablecimiento.
# ⚠️ NUNCA usar el valor por defecto en producción. Generar con:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
# Duración del token de reset en minutos (15–30 recomendado)
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# ── Rate limiting (anti-abuso en forgot-password) ─────────────
# Máx. solicitudes de reset por email por hora
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
PASSWORD_RESET_WINDOW_SECONDS=3600

# ── Correo transaccional ──────────────────────────────────────
# Proveedor: "resend" (preferido), "sendgrid" o "log" (dev, no envía nada real)
EMAIL_PROVIDER=log
# Resend
RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=TrackFlow <no-reply@trackflow.local>
# SendGrid (si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=tu_api_key_de_sendgrid
SENDGRID_FROM_EMAIL=no-reply@trackflow.local

# ── Frontend ──────────────────────────────────────────────────
# URL base del frontend para construir el enlace de reset:
#    <FRONTEND_URL>/reset-password?token=<TOKEN>
FRONTEND_URL=http://localhost:3001

# Frontend (Next.js — uis/backoffice/)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# ── CORS ───────────────────────────────────────────────────────────────
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3001,http://localhost:8001

# ─── Inventario (Hito 12 — doble BD) ─────────────────────
# URL de conexión a Supabase (PostgreSQL) para el módulo de inventario.
# Formato: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
# (Si Supabase entrega "postgres://", database.py la normaliza automáticamente.)
DATABASE_URL=postgresql+psycopg2://postgres:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Ruta del TinyDB genérico (auth / legado). Relativa al cwd del servicio.
TINYDB_DB_PATH=db.json

# Log del SQL generado (true solo en desarrollo; apagado en producción)
SQL_ECHO=false
